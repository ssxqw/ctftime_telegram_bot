# Создайте нового бота через @BotFather и вставьте токен.
TG_BOT_TOKEN=

# Необязательно: назначения можно менять в Telegram командами /setevents,
# /setachievements и /setboth. ID узнаются командой /where.
TG_CHAT_ID=
EVENTS_CHAT_ID=
ACHIEVEMENTS_CHAT_ID=
EVENTS_TOPIC_ID=
ACHIEVEMENTS_TOPIC_ID=
BOT_OWNER_ID=
# BOT_OWNER_ID можно узнать командой /whoami в личном чате. Если оставить
# пустым, бот запомнит администратора, который добавил его в группу.

# Обе команды: Shalena Bdj1lka и Shalena Bdjilka.
CTFTIME_TEAM_IDS=451320,376454

# Анонсы за 7 дней до старта; проверка каждые 3 часа.
EVENT_LOOKAHEAD_DAYS=7
CHECK_INTERVAL_MINUTES=180

# При первом запуске подхватить результаты команды за 14 дней.
RESULT_BACKFILL_DAYS=14
DB_PATH=data/bot.sqlite3
